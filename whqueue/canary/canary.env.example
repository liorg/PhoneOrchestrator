# ═══════════════════════════════════════════════════════════════════════════
# canary.env — botinbound:/opt/whqueue/repo/canary/canary.env
#   cp canary.env.example canary.env && chmod 600 canary.env   ·   לא ב-git
# ═══════════════════════════════════════════════════════════════════════════

# ── משותף עם whqueue — להעתיק מה-env של stack whqueue ─────────────────────
SUPABASE_URL=
# רק לפריסה הראשונה: deploy-canary.sh יוצר ממנו secret (canary_supabase_key),
# ואז מוחקים את השורה הזאת מכאן.
SUPABASE_SERVICE_ROLE_KEY=
WHQUEUE_VERIFY_TOKEN=
NATS_NODE=botinbound

# ── ה-host של ה-canary — agent_hosts.id של botinbound, מ-canary_host.sql ───
CANARY_HOST_ID=

# ── טלפון ה-canary ─────────────────────────────────────────────────────────
CANARY_PHONE_ID=e4ab3a7f-08bb-4e12-aea9-fd34279beb99
CANARY_PHONE_NUMBER=972507251926
CANARY_PHONE_NUMBER_ID=1247327145139602
CANARY_WABA_ID=1119020710931381
# טוקן /register מול whqueue — HMAC פר phone_id מ-whqueue_master (נגזר)
CANARY_WHQUEUE_PHONE_TOKEN=

# ── טוקן מטא — docker secret, לא כאן ─────────────────────────────────────
# נכתב ע"י ./set-canary-token.sh '<TOKEN>'. לא לערוך ידנית.
CANARY_WA_SECRET=

# ── canary-runner ↔ prober ────────────────────────────────────────────────
CANARY_INBOUND_TOKEN=        # openssl rand -hex 24
CANARY_RUNNER_PASSWORD=      # openssl rand -hex 16

# ORCH_TAG=latest
# CLOUDAPI_TAG=latest
# CANARY_LOG_LEVEL=INFO
