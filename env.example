IMAGE_NAME=phone-orchestrator

# Leave REGISTRY unset while the swarm is a single node - the image is built
# on the machine that runs it. Set it when a second node joins, otherwise the
# new node has no way to obtain the image.
# REGISTRY=10.186.0.3:5000

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=

# Dashboard login. Leave AUTH_PASSWORD empty to disable auth - the app logs a
# warning at startup when it is. Basic auth sends the password on every
# request in base64, so put TLS in front before exposing this beyond the VPC.
AUTH_USER=admin
AUTH_PASSWORD=
