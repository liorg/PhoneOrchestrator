# Copy to deploy.env, fill in, and keep deploy.env out of git.
#   cp deploy.env.example deploy.env
#   source deploy.env

# Where images live. Nothing in the stack should hard-code a node address -
# if the registry sits on a swarm node and that node is the one that failed,
# the replacement task cannot pull the image it needs to replace it.
export REGISTRY=10.186.0.3:5000
export IMAGE_NAME=phone-orchestrator

# Not a secret - it appears in every request. The service-role key is a
# swarm secret instead (see docker-compose.yml).
export SUPABASE_URL=https://xxxx.supabase.co
